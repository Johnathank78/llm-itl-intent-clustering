# Copier ce fichier en .env (jamais versionné) et compléter.

# Uniquement pour recalculer les embeddings (les embeddings du run sont déjà dans data/)
GEMINI_API_KEY=

# Serveur LLM compatible OpenAI. Par défaut : Ollama en local.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b
# Clé du serveur LLM si nécessaire (inutile pour Ollama)
LLM_API_KEY=
